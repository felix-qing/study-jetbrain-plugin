<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.felixqing.fitstmyhelloworldplugin</id>
    <name>fitst-my-hello-world-plugin</name>
    <vendor>felix-qing</vendor>
    <description><![CDATA[
        <p>一个简单的 Hello World 插件示例。</p>
    ]]></description>

    <!-- 依赖 IntelliJ 平台核心模块 -->
    <depends>com.intellij.modules.platform</depends>
    <!-- 注册菜单动作 -->
    <actions>
        <action id="HelloWorldAction"
                class="com.github.felixqing.fitstmyhelloworldplugin.HelloWorldAction"
                text="Say Hello World"
                description="弹出一个 Hello World 对话框">

            <!-- 放到 Tools 菜单最后 -->
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <!-- 快捷键：Ctrl + Shift + H -->
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift H"/>
        </action>
    </actions>
</idea-plugin>
